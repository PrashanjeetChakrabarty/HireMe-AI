            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Backend Developer Intern\",\n  \"description\": \"Work on ASP.NET Core APIs and SQL Server.\",\n  \"location\": \"Chennai, India\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/Jobs", "host": ["{{baseUrl}}"], "path": ["api", "Jobs"] }
          }
        },
        {
          "name": "Browse Open Jobs (Candidate)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/Jobs", "host": ["{{baseUrl}}"], "path": ["api", "Jobs"] }
          }
        },
        {
          "name": "My Jobs (Recruiter)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/Jobs/my-jobs", "host": ["{{baseUrl}}"], "path": ["api", "Jobs", "my-jobs"] }
          }
        },
        {
          "name": "Get Job By Id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/Jobs/{{jobId}}", "host": ["{{baseUrl}}"], "path": ["api", "Jobs", "{{jobId}}"] }
          }
        },
        {
          "name": "Update Job (Recruiter, own jobs only)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Backend Developer Intern (Updated)\",\n  \"description\": \"Work on ASP.NET Core APIs, SQL Server, and Python AI service.\",\n  \"location\": \"Chennai, India (Hybrid)\",\n  \"status\": \"Open\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/Jobs/{{jobId}}", "host": ["{{baseUrl}}"], "path": ["api", "Jobs", "{{jobId}}"] }
          }
        },
        {
          "name": "Delete Job (Recruiter, own jobs only)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/Jobs/{{jobId}}", "host": ["{{baseUrl}}"], "path": ["api", "Jobs", "{{jobId}}"] }
          }
        }
      ]
    },
    {
      "name": "Resumes",
      "item": [
        {
          "name": "Upload Resume",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('resumeId', pm.response.json().resumeId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/Resumes/upload/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "Resumes", "upload", "{{userId}}"] },
            "description": "In the Body tab, click 'Select Files' next to the 'file' field and pick a .pdf or .docx resume from your computer."
          }
        },
        {
          "name": "Get My Resumes",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/Resumes/candidate/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "Resumes", "candidate", "{{userId}}"] }
          }
        },
        {
          "name": "Download Resume",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/Resumes/download/{{resumeId}}", "host": ["{{baseUrl}}"], "path": ["api", "Resumes", "download", "{{resumeId}}"] }
          }
        },
        {
          "name": "Delete Resume",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/Resumes/{{resumeId}}", "host": ["{{baseUrl}}"], "path": ["api", "Resumes", "{{resumeId}}"] }
          }
        }
      ]
    },
