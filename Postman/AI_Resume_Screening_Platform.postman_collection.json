{
  "info": {
    "name": "AI Resume Screening Platform",
    "description": "Postman collection for testing all backend API endpoints of the AI Resume Screening Platform (ASP.NET Core backend, port 5140).\n\nHow to use:\n1. Run the 'Auth > Register Candidate' or 'Register Recruiter' request first, then verify OTP.\n2. Run 'Auth > Login' — this automatically saves the JWT token into the {{token}} collection variable (see the Tests tab on that request).\n3. All other requests use {{token}} automatically in their Authorization header, so once you log in, everything else just works.\n4. {{userId}} is also saved automatically after login — used by the Resumes and Users requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5140", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "jobId", "value": "", "type": "string" },
    { "key": "applicationId", "value": "", "type": "string" },
    { "key": "resumeId", "value": "", "type": "string" },
    { "key": "interviewId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Candidate",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Test Candidate\",\n  \"email\": \"testcandidate@example.com\",\n  \"password\": \"Passw0rd!\",\n  \"phone\": \"9876543210\",\n  \"address\": \"Chennai, India\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/Auth/register/candidate", "host": ["{{baseUrl}}"], "path": ["api", "Auth", "register", "candidate"] }
          }
        },
        {
          "name": "Register Recruiter",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Test Recruiter\",\n  \"email\": \"testrecruiter@example.com\",\n  \"password\": \"Passw0rd!\",\n  \"companyName\": \"HireMe AI\",\n  \"companyWebsite\": \"https://example.com\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/Auth/register/recruiter", "host": ["{{baseUrl}}"], "path": ["api", "Auth", "register", "recruiter"] }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testcandidate@example.com\",\n  \"otpCode\": \"123456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/Auth/verify-otp", "host": ["{{baseUrl}}"], "path": ["api", "Auth", "verify-otp"] }
          }
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testcandidate@example.com\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/Auth/resend-otp", "host": ["{{baseUrl}}"], "path": ["api", "Auth", "resend-otp"] }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Automatically saves the JWT token and userId so every other request in this collection works right away.",
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    pm.collectionVariables.set('token', data.token);",
                  "    pm.collectionVariables.set('userId', data.userId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testcandidate@example.com\",\n  \"password\": \"Passw0rd!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/Auth/login", "host": ["{{baseUrl}}"], "path": ["api", "Auth", "login"] }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testcandidate@example.com\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/Auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["api", "Auth", "forgot-password"] }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testcandidate@example.com\",\n  \"otpCode\": \"123456\",\n  \"newPassword\": \"NewPassw0rd!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/Auth/reset-password", "host": ["{{baseUrl}}"], "path": ["api", "Auth", "reset-password"] }
          }
        }
      ]
    },
    {
      "name": "Roles",
      "item": [
        {
          "name": "Get Register Options",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/Roles/register-options", "host": ["{{baseUrl}}"], "path": ["api", "Roles", "register-options"] }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/Users/profile/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "Users", "profile", "{{userId}}"] }
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Test Candidate Updated\",\n  \"phone\": \"9876543210\",\n  \"address\": \"Bangalore, India\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/Users/profile/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "Users", "profile", "{{userId}}"] }
          }
        },
        {
          "name": "Delete My Account",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"Passw0rd!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/Users/me", "host": ["{{baseUrl}}"], "path": ["api", "Users", "me"] }
          }
        }
      ]
    },
    {
      "name": "Jobs",
      "item": [
        {
          "name": "Create Job (Recruiter)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('jobId', pm.response.json().jobId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
